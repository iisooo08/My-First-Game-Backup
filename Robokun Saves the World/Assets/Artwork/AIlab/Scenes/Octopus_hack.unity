  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9436b93088f424a9bbb65c3f35287208, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: 
    sentences:
    - <Subject Log 1>
    - Subject is quiet and obedient. Often stares into the octopi in the aquariums
      for hours at length.
    - Subject had stated multiple times that he wanted to become one.
    - 'Possible reasoning for the behavior unknown. No anomalies within the brain. '
    - <Subject Log 2>
    - The subject cries often, and asks researchers for where his "Grandma" is. No
      anomalies within the brain.
    - <Subject Log 3>
    - 'Date and type of surgery chosen. '
    - <Subject Log 4>
    - I told the subject that he will become an octopus.
    pfp: {fileID: 0}
    pfp_int: 0
    nametag_int: 0
    fromlever: 0
    privname: 
